        }
      }
    },
    "Tempo does not need Input Monitoring, Full Disk Access, camera, or microphone." : {

    },
    "Tempo is a focus timer, a task board, and a private history of your work." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempo is a focus timer, a task board, and a private history of your work."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempo は集中タイマー、タスクボード、そして自分だけの作業履歴です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempo 是专注计时、任务看板，以及只属于你的工作记录。"
          }
        }
      }
    },
    "Tempo keeps focus, tasks, and history on this Mac. There is no account and nothing is uploaded." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempo keeps focus, tasks, and history on this Mac. There is no account and nothing is uploaded."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempo は集中、タスク、履歴をこの Mac に残します。アカウントはなく、アップロードもしません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempo 把专注、任务和历史留在这台 Mac 上。没有账号，也不会上传。"
          }
        }
      }
    },
