    "App names still record. Allow Accessibility, then quit Tempo once for window titles." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App names still record. Allow Accessibility, then quit Tempo once for window titles."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリ名は記録されます。ウィンドウタイトルにはアクセシビリティが必要です。許可したあとは Tempo を一度終了してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用名称仍会记录。窗口标题需要辅助功能，授权后请完全退出 Tempo 再打开。"
          }
        }
      }
